{% set isHome = (page.url == '/') %}
{% set pageTitle %}{% if isHome or not title %}{{ site.title }} · A plan for somewhere safe to go{% else %}{{ title }} · {{ site.title }}{% endif %}{% endset %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  {# Google Tag Manager. Renders only once site.gtm_id (site.json) holds a container ID. #}
  {% if site.gtm_id %}<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ site.gtm_id }}');</script>{% endif %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <title>{{ pageTitle | safe }}</title>

  <meta name="description" content="{{ meta_description or site.tagline }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle | safe }}">
  <meta property="og:description" content="{{ meta_description or site.tagline }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if site.social_image %}<meta property="og:image" content="{{ site.url }}{{ site.social_image }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <meta name="theme-color" content="#F6ECDF">
  <meta name="color-scheme" content="light">

  <link rel="preload" href="/assets/fonts/newsreader-roman.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin>

  {% if isHome %}<link rel="preload" as="image" href="/assets/images/plan/house-drawing-2000.webp" imagesrcset="{{ '/assets/images/plan/house-drawing-1000.webp' | url }} 1000w, {{ '/assets/images/plan/house-drawing-2000.webp' | url }} 2000w" imagesizes="100vw" fetchpriority="high">{% endif %}
  {% if not isHome and hero_image %}<link rel="preload" as="image" href="{{ hero_image }}" fetchpriority="high">{% endif %}
  <script>document.documentElement.className += " js";</script>
  <link rel="stylesheet" href="/assets/plan.css">
  {% if not isHome %}<link rel="stylesheet" href="/assets/plan-inner.css">{% endif %}

  {# Organization schema. Street address is deliberately omitted: this is a
     residential program and the housing location is confidential. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "{{ site.title }}",
    "url": "{{ site.url }}",
    "email": "{{ site.email }}",
    "telephone": "{{ site.phone }}",
    "taxID": "{{ site.ein }}",
    "description": "{{ site.tagline }}",
    "address": { "@type": "PostalAddress", "addressLocality": "{{ site.city }}", "addressRegion": "{{ site.state }}", "addressCountry": "US" }
  }
  </script>
</head>
<body class="plan">
  {% if site.gtm_id %}<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtm_id }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>{% endif %}
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="chrome" data-chrome>
    <a class="chrome-brand" href="/" aria-label="{{ site.title }} home">
      <img src="/assets/images/logo-lockup.svg" alt="{{ site.title }}" width="320" height="100">
    </a>
    <div class="chrome-right">
      {# The gold button is the gift, on every page, in the same spot. "Fund a line" is the quieter way in, and is left off the money page because it would send the donor back to the home page. #}
      {% if page.url != '/give/' %}
      <a class="btn btn-outline" href="{% if isHome %}#fund{% else %}/#fund{% endif %}">Fund a line</a>
      {% endif %}
      <a class="btn btn-gold" href="{{ site.donation_url }}?utm_source=site&amp;utm_medium={% if page.url == '/give/' %}header-give{% else %}header{% endif %}&amp;utm_campaign=the-plan" target="_blank" rel="noopener" aria-label="Give now"><span class="btn-give-long">Give now</span><span class="btn-give-short" aria-hidden="true">Give</span></a>
      <button class="chrome-menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">Menu</span><i></i><i></i>
      </button>
    </div>
  </header>

  <nav class="menu" id="menu" aria-label="Primary" hidden data-menu>
    <div class="menu-inner">
      <a href="/"{% if isHome %} aria-current="page"{% endif %}>Home</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      <a href="/founder/"{% if page.url == '/founder/' %} aria-current="page"{% endif %}>Founder</a>
      <a href="/programs/"{% if page.url == '/programs/' %} aria-current="page"{% endif %}>Programs</a>
      <a href="/give/"{% if page.url == '/give/' %} aria-current="page"{% endif %}>Ways to give</a>
      <a href="/faq/"{% if page.url == '/faq/' %} aria-current="page"{% endif %}>Questions</a>
      <a href="/contact/"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a>
      <a class="menu-give" href="{{ site.donation_url }}" target="_blank" rel="noopener">Give now</a>
    </div>
  </nav>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="foot">
    <img class="foot-mark" src="/assets/images/logo-mark.svg" alt="" width="64" height="64">
    <p class="foot-line">Walking alongside women in recovery, in a Christ-centered home.</p>
    <p class="foot-meta">{{ site.service_area }} · {{ site.legal_status }} · EIN {{ site.ein }}</p>
    <p class="foot-links">
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a href="tel:{{ site.phone | replace('-', '') }}">{{ site.phone }}</a>
      <a href="/faq/">Questions</a>
      <a href="/contact/">Contact</a>
    </p>
    <p class="foot-small">&copy; {% year %} {{ site.title }}. The house location will stay private to protect the women who will live there.</p>
  </footer>

  <script src="/assets/plan.js" defer></script>
  {% if not isHome %}<script src="/assets/plan-inner.js" defer></script>{% endif %}
  {% if form_page %}<script src="/assets/plan-form.js" defer></script>{% endif %}
</body>
</html>
